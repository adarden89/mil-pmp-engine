# -----------------------------------------------------------------------------
# MilToPMP Enterprise environment
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional at boot: the marketing pages render without
# them, and API routes that need a missing value return 503 "not_configured".
# -----------------------------------------------------------------------------

# Public base URL, used for Stripe success/cancel URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth, entitlements, flashcard progress, usage ledger) ---------
# Project Settings -> API. The publishable key (sb_publishable_...) is safe for
# the browser; the legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or legacy service_role key. Server only: it
# bypasses row-level security and is used solely for purchases/entitlements.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Stripe (checkout, 1-click add-ons, webhooks) ---------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint in the Stripe dashboard, or from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Anthropic (Military-to-PMI Translation Studio) -------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Live translations allowed per user per rolling 30 days. Default 40.
TRANSLATION_LIMIT_PER_30_DAYS=40
