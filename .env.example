# -----------------------------------------------------------------------------
# MilToPMP Enterprise environment
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional at boot: pages render without them, and API
# routes that need a missing value return 503 "not_configured".
# GET /api/health reports which integrations are configured (never values).
# -----------------------------------------------------------------------------

# Public base URL: Stripe redirect URLs, sign-in links in emails, tracking origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: auth, entitlements, plans, ledgers ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works, under
# this name or as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY: bypasses
# row-level security; used for purchases, provisioning, and ledgers.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Stripe: checkout, 1-click add-ons, order delivery webhook --------------
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable key for the in-page checkout modal (Stripe Elements, Apple Pay,
# Google Pay). Exposed to the browser as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# Without it, checkout falls back to the Stripe-hosted page. Apple Pay also
# needs your domain registered under Settings > Payment method domains.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret of the /api/webhooks/stripe endpoint, or from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Human expert application review ($299 service) -------------------------
# Leave unset (or false) until a reviewer is staffed to fulfill orders. When
# true, the dashboard offers the review and checkout accepts it.
EXPERT_REVIEW_ENABLED=false
# Where new review orders are emailed for a human to pick up.
EXPERT_REVIEW_INBOX=reviews@yourdomain.com

# --- Anthropic: Translation Studio and the ad creative CLI ------------------
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Live translations per user per rolling 30 days. Default 40.
TRANSLATION_LIMIT_PER_30_DAYS=40

# --- Resend: post-purchase access email -------------------------------------
RESEND_API_KEY=re_xxx
# A sender on a domain you verified in Resend.
RESEND_FROM_EMAIL="MilToPMP <access@yourdomain.com>"

# --- Meta Conversions API + Pixel -------------------------------------------
# The pixel id is also exposed to the browser (it is public by design).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional. Graph API version for the Conversions API. Default v24.0.
META_GRAPH_API_VERSION=v24.0
# Optional. Set while testing in Events Manager > Test events; remove in production.
META_TEST_EVENT_CODE=

# --- TikTok Events API + Pixel ----------------------------------------------
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
# Optional. Set while testing in Events Manager; remove in production.
TIKTOK_TEST_EVENT_CODE=

# --- Privacy ----------------------------------------------------------------
# opt-out: share ad data unless the visitor opts out or sends Global Privacy
#          Control (US state-law model). opt-in: share only after consent
#          (use for EU/UK traffic). Have counsel confirm which applies.
TRACKING_CONSENT_MODE=opt-out
